---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
---

<LandingLayout
  title="Lorena Brandão"
  description="Consultoria em processos industriais e SAP, com atuação em governança de dados mestres, estruturação de cadastros e eficiência produtiva."
  image="/og-default.svg"
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" showScrollIndicator descriptionClass="max-w-3xl">
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">Disponível para novos projetos</Badge>

    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Lorena Brandão</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] dark:text-foreground dark:[-webkit-text-fill-color:currentColor]">Consultoria Industrial</span><span class="text-foreground [-webkit-text-fill-color:currentColor]"></span>
    </h1>

    <p slot="description">
      Consultoria em processos industriais e SAP, com atuação em governança de dados mestres, estruturação de cadastros e eficiência produtiva.
    </p>

   <Fragment slot="actions">
      <Button size="lg" href="https://www.linkedin.com/in/lorena-brandao/">
        LinkedIn
        <Icon name="linkedin" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="https://wa.me/qr/KPQ6NIDN265XH1">
        WhatsApp
        <Icon name="whatsapp" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Principais soluções
          </h2>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal data-reveal-delay="1">
        <!-- Web Design -->
        <Card hover variant="elevated" class={"h-fit"}>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Análise de causa de problemas produtivos</h3>
            </div>
        </Card>
        <Card hover variant="elevated" class={"h-fit"}>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Organização de fluxo de produção</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Kanban, urgências, planejamento
              </p>
            </div>
        </Card>
        <Card hover variant="elevated" class={"h-fit"}>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Ajustes e suporte em SAP</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                PCP, ordens, cadastros
              </p>
            </div>
        </Card>
        <Card hover variant="elevated" class={"h-fit"}>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Redução de perdas e retrabalho</h3>
            </div>
        </Card>
        <Card hover variant="elevated" class={"h-fit"}>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Padronização de processos</h3>
            </div>
        </Card>

        
      </div>
    </div>
  </section>

  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col justify-center" data-reveal>
          <div class="flex flex-col gap-6 mb-6">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              Sobre mim
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4">
           Sou especialista em processos industriais, com experiência prática no chão de fábrica, atuando diretamente na resolução de problemas reais de produção.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4">
           Tenho foco em soluções simples, aplicáveis e que geram resultado rápido, sem complicação desnecessária.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4">
           Já atuei com processos de extrusão, recuperação de materiais e gestão de produção, sempre focando em eficiência e qualidade.
          </p>
        </div>
        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal data-reveal-delay="1">
          <div class="grid grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="cog" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Experiência em extrusão, PCP e Engenharia</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="map-pin" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Atendemos pequenas e grandes empresas de Manaus</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="folder-open" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Gestão de Processos</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="chart-no-axes-combined" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Eficiência</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Serviços
          </h2>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2" data-reveal data-reveal-delay="1">
          <Card variant="elevated" hover padding="lg" class="group flex flex-col">
            <div class="flex flex-1 flex-col">
              <div class="mb-3 flex items-start justify-between gap-4">
              </div>
              <div class="mb-2 flex items-baseline gap-2">
                <h3 class="font-display text-lg font-bold text-foreground">Diagnóstico de Processos</h3>
              </div>
              <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">Identifico falhas, gargalos e desperdícios na sua operação.</p>
            </div>
          </Card>
          <Card variant="elevated" hover padding="lg" class="group flex flex-col">
            <div class="flex flex-1 flex-col">
              <div class="mb-3 flex items-start justify-between gap-4">
              </div>
              <div class="mb-2 flex items-baseline gap-2">
                <h3 class="font-display text-lg font-bold text-foreground">Melhoria de Produção</h3>
              </div>
              <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">Reorganizo fluxo produtivo, trato urgências e melhoro o planejamento.</p>
            </div>
          </Card>
          <Card variant="elevated" hover padding="lg" class="group flex flex-col">
            <div class="flex flex-1 flex-col">
              <div class="mb-3 flex items-start justify-between gap-4">
              </div>
              <div class="mb-2 flex items-baseline gap-2">
                <h3 class="font-display text-lg font-bold text-foreground">Suporte SAP (PCP e Produção)</h3>
              </div>
              <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">Ajustes em ordens, cadastros, erros de sistema e integração com operação.</p>
            </div>
          </Card>
          <Card variant="elevated" hover padding="lg" class="group flex flex-col">
            <div class="flex flex-1 flex-col">
              <div class="mb-3 flex items-start justify-between gap-4">
              </div>
              <div class="mb-2 flex items-baseline gap-2">
                <h3 class="font-display text-lg font-bold text-foreground">Padronização</h3>
              </div>
              <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">Criação de procedimentos claros e aplicáveis para sua equipe.</p>
            </div>
          </Card>
      </div>
    </div>
  </section>

  <section class="relative z-10 py-[var(--space-section-md)] bg-background">
    <div class="mx-auto max-w-2xl px-6 text-center" data-reveal>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Tem um desafio na sua produção?
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Seja um processo que precisa de ajustes ou uma operação que exige mais eficiência — eu posso te ajudar a identificar falhas, organizar o fluxo e aplicar soluções práticas que geram resultado rápido, sem complicação desnecessária.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="https://www.linkedin.com/in/lorena-brandao/">
          LinkedIn
          <Icon name="linkedin" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="https://wa.me/qr/KPQ6NIDN265XH1">
          WhatsApp
          <Icon name="whatsapp" size="sm" />
        </Button>
      </div>
    </div>
  </section>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initCountup);
</script>
</LandingLayout>
